# Ruxstar Application Services — environment variables (copy to .env and fill in)
# EXPO_PUBLIC_* variables are embedded at build time by Expo and are visible in the app bundle.

# Backend API base URL (Cloud Run, asia-south1)
EXPO_PUBLIC_API_URL=

# Deep-link scheme (must match app.json)
EXPO_PUBLIC_APP_SCHEME=

# OneSignal Dashboard → Settings → Keys & IDs
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Sentry project DSN (public client key). Leave empty to disable crash reporting.
EXPO_PUBLIC_SENTRY_DSN=

# Mock mode: auto (default, only routes flagged mocked), all (offline demo), off (real API only)
EXPO_PUBLIC_USE_MOCKS=auto
